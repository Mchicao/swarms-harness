{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bolmer/swarms-harness/schemas/state-v2/task-state.schema.json",
  "title": "SWARMS Task State v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "task_id",
    "source_id",
    "stage",
    "role",
    "requested_route",
    "effective_route",
    "needs",
    "depth",
    "status",
    "attempt",
    "max_attempts",
    "created_at",
    "updated_at",
    "artifacts",
    "verification",
    "usage"
  ],
  "properties": {
    "schema": {"const": "swarms.task-state"},
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "requested_route": {"type": "string", "minLength": 1},
    "effective_route": {"type": "string", "minLength": 1},
    "needs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "parent_task_id": {"type": ["string", "null"]},
    "depth": {"type": "integer", "minimum": 0},
    "status": {
      "enum": ["pending", "running", "succeeded", "failed", "blocked", "cancelled"]
    },
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "last_activity_at": {"type": ["string", "null"], "format": "date-time"},
    "terminal_reason": {"type": ["string", "null"]},
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "message", "retryable"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"}
      }
    },
    "worker_log": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "bytes"],
      "properties": {
        "path": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "session": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["mode", "reused"],
      "properties": {
        "mode": {"enum": ["disabled", "new", "reuse"]},
        "reused": {"type": "boolean"},
        "public_id": {"type": ["string", "null"]}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status"],
        "properties": {
          "path": {"type": "string"},
          "status": {"enum": ["pending", "present", "missing", "rejected"]},
          "message": {"type": ["string", "null"]}
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "status"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "status": {"enum": ["pending", "passed", "failed", "cancelled", "timed_out"]},
          "exit_code": {"type": ["integer", "null"]},
          "message": {"type": ["string", "null"]}
        }
      }
    },
    "usage": {"$ref": "#/$defs/usage"}
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "source", "complete"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "source": {"type": "string", "minLength": 1},
        "complete": {"type": "boolean"}
      }
    }
  }
}
